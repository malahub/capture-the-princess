; Heavy Flag — isometric 3D capture-the-princess siege.
; Original title, original art, original code. No source assets from any commercial game.

config_version=5

[application]

config/name="Capture The Princess"
config/description="Isometric 3D castle siege: rescue your princess, feed the enemy's cake so she is too heavy to move."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.09, 0.11, 0.15, 1)

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.09, 0.11, 0.15, 1)
anti_aliasing/quality/msaa_3d=1
textures/default_filters/anisotropic_filtering_level=2

[physics]

common/physics_ticks_per_second=60
3d/default_gravity=24.0
